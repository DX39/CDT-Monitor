<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cdt_surface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CDT Monitor"
            android:textColor="@color/cdt_ink"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="为桌面小组件连接一个只读的 CDT Monitor API Key。"
            android:textColor="@color/cdt_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/glass_surface"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="站点地址"
                android:textColor="@color/cdt_ink"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/site_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_surface"
                android:hint="例如 https://monitor.example.com"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/cdt_ink"
                android:textColorHint="@color/cdt_muted" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="API Key"
                android:textColor="@color/cdt_ink"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/api_key"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_surface"
                android:hint="cdt_xxx"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/cdt_ink"
                android:textColorHint="@color/cdt_muted" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="请在 CDT Monitor 设置中创建只包含 widget:read scope 的 Key。Key 会使用本机 Android Keystore 加密保存。"
                android:textColor="@color/cdt_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <Button
            android:id="@+id/save_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_primary"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:text="保存并测试连接" />
        <TextView
            android:id="@+id/settings_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/cdt_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
