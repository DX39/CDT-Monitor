<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cdt_surface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CDT Monitor"
            android:textColor="@color/cdt_ink"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="为桌面小组件连接一个只读的 CDT Monitor API Key。"
            android:textColor="@color/cdt_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="站点地址"
            android:textColor="@color/cdt_ink"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/site_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 https://monitor.example.com"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="API Key"
            android:textColor="@color/cdt_ink"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cdt_xxx"
            android:inputType="textPassword"
            android:singleLine="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="请在 CDT Monitor 设置中创建只包含 widget:read scope 的 Key。Key 会使用本机 Android Keystore 加密保存。"
            android:textColor="@color/cdt_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="保存并测试连接" />
        <TextView
            android:id="@+id/settings_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/cdt_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
