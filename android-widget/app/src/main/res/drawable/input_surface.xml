<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/cdt_surface_elevated" />
            <corners android:radius="13dp" />
            <stroke android:width="2dp" android:color="@color/cdt_blue" />
            <padding android:left="14dp" android:top="2dp" android:right="14dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/cdt_surface_elevated" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/cdt_border" />
            <padding android:left="14dp" android:top="3dp" android:right="14dp" android:bottom="3dp" />
        </shape>
    </item>
</selector>
